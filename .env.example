PGHOST=localhost
PGPORT=5433
PGDATABASE=warehouse
PGUSER=dqs
PGPASSWORD=dqs
PG_RO_USER=dqs_ro
PG_RO_PASSWORD=dqs_ro

LLM_PROVIDER=anthropic          # anthropic | openai | google_genai | ollama | openai_compatible | fake
LLM_MODEL=claude-haiku-5-5      # cheap model for development
LLM_MODEL_BENCH=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# OpenAI-compatible endpoints (DeepSeek, Kimi, GLM, OpenRouter, local Ollama).
# Required for LLM_PROVIDER=openai_compatible; optional base URL for ollama.
LLM_BASE_URL=
LLM_API_KEY=

GITHUB_MODE=dry_run             # dry_run | live
GITHUB_TOKEN=                   # fine-grained PAT: contents, pull requests, issues (R/W) on ONE repo
GITHUB_REPO=owner/repo
GITHUB_BASE_BRANCH=main

MAX_TOOL_CALLS=10
MAX_FIX_ATTEMPTS=3
MAX_TOKENS_PER_INCIDENT=60000
FIXER_MAX_OUTPUT_TOKENS=8192    # per-call completion ceiling for the fixer
INCIDENT_TIMEOUT_SECONDS=900
LLM_MAX_RETRIES=3               # transient 429/5xx only
LLM_RETRY_MAX_WAIT_SECONDS=30   # hard cumulative cap; a huge Retry-After fails fast
LLM_RETRY_BASE_SECONDS=1.0      # exponential backoff base
DQS_SEED=42

DQS_SANDBOX_SCHEMA=dqs_sandbox_tmp  # set per verification run (Phase 5; ARCHITECTURE.md §5)

LANGFUSE_PUBLIC_KEY=            # optional (Phase 9)
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
